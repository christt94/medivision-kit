# Safe local defaults. Copy this file to .env for local configuration.
DEBUG=true
APP_NAME=MediVision Kit
VERSION=0.1.0
COUNTRY_CODE=CM
SQLITE_PATH=data/medivision.db
DUCKDB_PATH=data/refs.duckdb
MODELS_DIR=data/models
FILES_DIR=data/files
SECRET_KEY=
SESSION_TIMEOUT_MIN=15
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_BYTES=52428800

# Keep this as none when running without model credentials or model weights.
IMAGING_MODEL=none

# Do not commit Hugging Face tokens. Authenticate locally with `hf auth login`
# when you are on a network that can access the model.
